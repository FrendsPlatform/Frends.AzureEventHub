<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <authors>Frends</authors>
        <copyright>Frends</copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/FrendsPlatform/Frends.AzureEventHub</PackageProjectUrl>
        <IncludeSource>true</IncludeSource>
        <PackageTags>Frends</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>1.3.0</Version>
        <Description>Task for sending events to Azure Event Hub.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="FrendsTaskMetadata.json" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.17.1"/>
        <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2"/>
        <PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0"/>
    </ItemGroup>

</Project>
